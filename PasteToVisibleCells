Sub PasteToVisibleCells()

    If Application.CutCopyMode <> xlCopy Then
        MsgBox "먼저 Ctrl+C로 복사해 주세요.", vbExclamation
        Exit Sub
    End If

    Dim dstAddr As String
    dstAddr = InputBox("붙여넣을 대상 범위를 입력하세요." & vbCrLf & _
                       "(예: A1:A200  또는  Sheet2!A1:A200)", "대상 범위")
    If dstAddr = "" Then Exit Sub

    Dim dstRange As Range
    On Error GoTo InvalidRange
    Set dstRange = Range(dstAddr)
    On Error GoTo 0

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    ' ── 현재 시트의 사용 범위 오른쪽 빈 공간에 임시 붙여넣기 ──
    ' (시트 전환 없음 → CutCopyMode 유지됨)
    Dim ws As Worksheet
    Set ws = ActiveSheet

    Dim tempCol As Long, tempRow As Long
    tempCol = ws.UsedRange.Column + ws.UsedRange.Columns.Count + 100
    tempRow = 1

    ' 열이 범위 초과 시 행 방향으로 대피
    If tempCol > ws.Columns.Count Then
        tempCol = 1
        tempRow = ws.UsedRange.Row + ws.UsedRange.Rows.Count + 100
    End If

    Dim tempCell As Range
    Set tempCell = ws.Cells(tempRow, tempCol)

    On Error GoTo PasteError
    tempCell.PasteSpecial Paste:=xlPasteValues
    On Error GoTo 0

    ' PasteSpecial 직후 Selection = 붙여넣어진 범위
    Dim pastedRange As Range
    Set pastedRange = Selection

    ' ── 배열로 읽기 ──
    Dim totalCells As Long
    Dim flatVals() As Variant

    If pastedRange.Cells.Count = 1 Then
        totalCells = 1
        ReDim flatVals(1 To 1)
        flatVals(1) = pastedRange.Value
    Else
        Dim vals As Variant
        vals = pastedRange.Value
        Dim tR As Long, tC As Long
        tR = UBound(vals, 1)
        tC = UBound(vals, 2)
        totalCells = tR * tC
        ReDim flatVals(1 To totalCells)
        Dim r As Long, c As Long, i As Long
        i = 0
        For r = 1 To tR
            For c = 1 To tC
                i = i + 1
                flatVals(i) = vals(r, c)
            Next c
        Next r
    End If

    ' 임시 영역 내용만 삭제 (셀 이동 없음)
    pastedRange.ClearContents

    ' ── 보이는 셀 가져오기 ──
    Dim visibleRange As Range
    On Error GoTo NoVisible
    Set visibleRange = dstRange.SpecialCells(xlCellTypeVisible)
    On Error GoTo 0

    ' ── Area별 배열 일괄 쓰기 ──
    Dim idx As Long
    idx = 0
    Dim srcDone As Boolean
    srcDone = False
    Dim area As Range

    For Each area In visibleRange.Areas
        If srcDone Then Exit For

        Dim aRows As Long, aCols As Long
        aRows = area.Rows.Count
        aCols = area.Columns.Count

        If idx + (aRows * aCols) <= totalCells Then
            ' 전체 Area 일괄 쓰기 (빠름)
            Dim subArr() As Variant
            ReDim subArr(1 To aRows, 1 To aCols)
            Dim ri As Long, ci As Long
            For ri = 1 To aRows
                For ci = 1 To aCols
                    idx = idx + 1
                    subArr(ri, ci) = flatVals(idx)
                Next ci
            Next ri
            area.Value = subArr
        Else
            ' 마지막 Area만 셀 단위 쓰기 (원본 소진 시점 정확히 처리)
            Dim cell As Range
            For Each cell In area.Cells
                If idx >= totalCells Then
                    srcDone = True
                    Exit For
                End If
                idx = idx + 1
                cell.Value = flatVals(idx)
            Next cell
            srcDone = True
        End If
    Next area

    MsgBox idx & "개 셀을 붙여넣었습니다.", vbInformation
    GoTo Done

PasteError:
    MsgBox "붙여넣기 실패. 다시 Ctrl+C 후 즉시 실행해 주세요.", vbCritical
    GoTo Done

NoVisible:
    MsgBox "대상 범위에 보이는 셀이 없습니다.", vbExclamation
    GoTo Done

InvalidRange:
    MsgBox "잘못된 범위 주소입니다.", vbCritical

Done:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True

End Sub
