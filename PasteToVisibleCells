Sub PasteToVisibleCells()

    ' 1. 복사 상태 확인
    If Application.CutCopyMode <> xlCopy Then
        MsgBox "먼저 붙여넣을 셀을 Ctrl+C로 복사해 주세요.", vbExclamation
        Exit Sub
    End If

    ' 2. 대상 범위 입력
    Dim dstAddr As String
    dstAddr = InputBox("붙여넣을 대상 범위를 입력하세요." & vbCrLf & _
                       "(예: A1:A200  또는  Sheet2!A1:A200)", "대상 범위")
    If dstAddr = "" Then Exit Sub

    Dim dstRange As Range
    On Error GoTo InvalidRange
    Set dstRange = Range(dstAddr)
    On Error GoTo 0

    ' 3. 임시 숨김 시트에 클립보드 내용 붙여넣기
    Application.ScreenUpdating = False

    Dim tempSheet As Worksheet
    Set tempSheet = Worksheets.Add
    tempSheet.Visible = xlSheetVeryHidden  ' 사용자에게 안 보임

    tempSheet.Range("A1").PasteSpecial Paste:=xlPasteValues

    ' 4. 붙여넣어진 데이터를 1차원 배열로 flatten
    Dim srcData As Range
    Set srcData = tempSheet.UsedRange

    Dim vals As Variant
    vals = srcData.Value  ' 2D 배열

    Dim totalCells As Long
    totalCells = srcData.Rows.Count * srcData.Columns.Count

    Dim flatVals() As Variant
    ReDim flatVals(1 To totalCells)

    Dim r As Long, c As Long, idx As Long
    idx = 0
    For r = 1 To srcData.Rows.Count
        For c = 1 To srcData.Columns.Count
            idx = idx + 1
            flatVals(idx) = vals(r, c)
        Next c
    Next r

    ' 5. 임시 시트 삭제
    Application.DisplayAlerts = False
    tempSheet.Delete
    Application.DisplayAlerts = True

    ' 6. 대상 범위의 보이는 셀에만 순서대로 붙여넣기
    Dim dstCell As Range
    idx = 0
    For Each dstCell In dstRange
        If dstCell.EntireRow.Hidden = False And _
           dstCell.EntireColumn.Hidden = False Then
            idx = idx + 1
            If idx > totalCells Then
                MsgBox "원본 데이터(" & totalCells & "개)를 모두 붙여넣었습니다." & vbCrLf & _
                       "대상 범위에 보이는 셀이 더 남아 있습니다.", vbInformation
                GoTo Done
            End If
            dstCell.Value = flatVals(idx)
        End If
    Next dstCell

    MsgBox idx & "개 셀을 붙여넣었습니다.", vbInformation
    GoTo Done

InvalidRange:
    MsgBox "잘못된 범위 주소입니다. 다시 확인해 주세요.", vbCritical

Done:
    Application.ScreenUpdating = True

End Sub
