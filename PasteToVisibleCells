Sub PasteToVisibleCells()

    If Application.CutCopyMode <> xlCopy Then
        MsgBox "먼저 Ctrl+C로 복사해 주세요.", vbExclamation
        Exit Sub
    End If

    Dim dstAddr As String
    dstAddr = InputBox("붙여넣을 대상 범위를 입력하세요." & vbCrLf & _
                       "(예: A1:A200  또는  Sheet2!A1:A200)", "대상 범위")
    If dstAddr = "" Then Exit Sub

    Dim dstRange As Range
    On Error GoTo InvalidRange
    Set dstRange = Range(dstAddr)
    On Error GoTo 0

    ' ── 성능 설정 ──────────────────────────────
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    ' ── 클립보드 → 임시 시트에 붙여넣기 ────────
    Dim tempSheet As Worksheet
    Set tempSheet = Worksheets.Add
    tempSheet.Range("A1").PasteSpecial Paste:=xlPasteValues

    Dim vals As Variant
    vals = tempSheet.UsedRange.Value  ' 2D 배열로 한번에 읽기

    Dim totalRows As Long, totalCols As Long
    totalRows = UBound(vals, 1)
    totalCols = UBound(vals, 2)

    ' 1D flatten
    Dim flatVals() As Variant
    ReDim flatVals(1 To totalRows * totalCols)
    Dim r As Long, c As Long, idx As Long
    idx = 0
    For r = 1 To totalRows
        For c = 1 To totalCols
            idx = idx + 1
            flatVals(idx) = vals(r, c)
        Next c
    Next r

    Dim totalCells As Long
    totalCells = idx

    ' 임시 시트 삭제
    Application.DisplayAlerts = False
    tempSheet.Visible = xlSheetVisible
    tempSheet.Delete
    Application.DisplayAlerts = True

    ' ── 보이는 셀만 가져오기 ────────────────────
    Dim visibleRange As Range
    On Error GoTo NoVisible
    Set visibleRange = dstRange.SpecialCells(xlCellTypeVisible)
    On Error GoTo 0

    ' ── Area별 배열 일괄 쓰기 (핵심 속도 개선) ──
    idx = 0
    Dim area As Range
    For Each area In visibleRange.Areas
        Dim aRows As Long, aCols As Long
        aRows = area.Rows.Count
        aCols = area.Columns.Count

        Dim subArr() As Variant
        ReDim subArr(1 To aRows, 1 To aCols)

        Dim ri As Long, ci As Long
        For ri = 1 To aRows
            For ci = 1 To aCols
                idx = idx + 1
                If idx > totalCells Then GoTo Overflow
                subArr(ri, ci) = flatVals(idx)
            Next ci
        Next ri

        area.Value = subArr  ' 영역 전체를 한 번에 씀
    Next area

    MsgBox idx & "개 셀을 붙여넣었습니다.", vbInformation
    GoTo Done

Overflow:
    MsgBox "원본 데이터 " & totalCells & "개를 모두 붙여넣었습니다.", vbInformation
    GoTo Done

NoVisible:
    MsgBox "대상 범위에 보이는 셀이 없습니다.", vbExclamation
    GoTo Done

InvalidRange:
    MsgBox "잘못된 범위 주소입니다.", vbCritical

Done:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True

End Sub
